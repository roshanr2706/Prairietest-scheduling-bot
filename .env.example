# Discord or Slack incoming webhook — fires only on real bookings + hard failures
WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# CWL credentials: gate the web UI login AND drive the headless PrairieTest login
CWL_USERNAME=your_cwl_username
CWL_PASSWORD=your_cwl_password

# Long random string that signs the web UI session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# Set to 1 when served over HTTPS (e.g. behind Nginx Proxy Manager / a TLS proxy)
# so the session cookie is only sent over TLS. Leave unset for plain-HTTP LAN/tunnel access.
SECURE_COOKIES=0
